{
  "name": "reversim-2026-mcp",
  "version": "0.1.0",
  "description": "MCP server that helps Reversim Summit 2026 attendees find the best sessions for them and plan their schedule.",
  "author": "Inbar Danieli",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "start": "tsx src/dev-server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "update-snapshot": "tsx scripts/update-snapshot.ts",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vercel/functions": "3.11.3",
    "slug": "10.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/slug": "5.0.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
